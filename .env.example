# 로컬 실행 프로필(IntelliJ 환경변수로 설정하는 경우 이 값은 생략 가능)
SPRING_PROFILES_ACTIVE=local

# 데이터베이스 연결
DB_URL=jdbc:mysql://localhost:3306/DB_NAME?serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=root
DB_PW=DB_PASSWORD

JWT_SECRET=replace-with-at-least-32-byte-secret
AUTH_ACCESS_TOKEN_TTL=1h
AUTH_REFRESH_TOKEN_TTL=14d

BODEUM_BASE_URL=https://api.example.com
OAUTH_MOCK_ENABLED=false

# 소셜 로그인 완료 후 일회용 code를 붙여 리다이렉트할 프론트 콜백 URL
FRONT_CALLBACK_URL=https://your-frontend.example.com/auth/callback

# REDIRECT_URI는 백엔드가 provider 콜백을 받는 주소 → 운영은 프론트 도메인이 아니라 API 도메인 사용
# 운영 예: https://api.bodeum.site/api/v1/auth/callback/{kakao|naver} / 로컬 예: http://localhost:8080/api/v1/auth/callback/{kakao|naver}
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_SCOPE=
KAKAO_TOKEN_URI=
KAKAO_USER_INFO_URI=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
NAVER_TOKEN_URI=
NAVER_USER_INFO_URI=

# AWS S3 (프로필 이미지 업로드)
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
# CloudFront 등 CDN을 앞단에 둘 경우 그 도메인. 비우면 표준 S3 URL 사용
AWS_S3_PUBLIC_BASE_URL=

# 공공데이터 인증 키
OPENAPI_SECRET_DATAGO=
OPENAPI_SECRET_ODCLOUD=
OPENAPI_SECRET_GG=
# OpenAI
OPENAI_API_KEY=

# 공공데이터포털 ODCloud
OPENAPI_SECRET_ODCLOUD=
# 로컬 서버 시작 시 News 공공데이터(수원·구리·성남)를 동기화할 때만 true
NEWS_PUBLIC_DATA_SYNC_ON_STARTUP=false

# 평소에는 false. 전체 재색인 실행 시에만 true
AI_INDEXING_RUN_ONCE=false

# Redis (AWS ElastiCache)
REDIS_HOST=your-redis-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-redis-auth-token
REDIS_SSL=true
